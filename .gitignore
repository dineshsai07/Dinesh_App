# D.I.N.E.S.H — local secrets, caches, and OS junk
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.coverage
htmlcov/

# ── Personal / runtime data (NEVER publish) ───────────────────
# Memory databases (any name / location under the app package)
**/memory/*.db
**/memory/*.db-shm
**/memory/*.db-wal
**/memory/*.db-journal
*.db
*.db-shm
*.db-wal

# Training exports, Modelfiles with host paths, LoRA weights
**/memory/dataset.jsonl
**/memory/adapters/
**/memory/exports/
**/memory/training/
**/memory/training/**

# Screenshots & HUD capture dumps
**/screenshots/
**/hud/screens/
hud_screens/
*.png
*.jpg
*.jpeg
*.webp
!docs/**/*.png

# MediaPipe model binaries (downloaded by main.py setup)
**/vision_models/*.task

# Logs
*.log
/tmp/

# Legacy nested trees (none expected in clean checkouts)

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.cursor/
